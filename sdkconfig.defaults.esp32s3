CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=102400
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Wake word: MultiNet custom wake words (你好小智 + 你好小何)
# CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS is not set
CONFIG_USE_AFE_WAKE_WORD=n
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_CUSTOM_WAKE_WORD="ni hao xiao zhi"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="你好小智"
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=5
CONFIG_CUSTOM_WAKE_WORD_2="ni hao xiao he"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY_2="你好小何"

# Keep the camera DMA bounce buffer out of internal SRAM so AFE/WakeNet10
# still has a usable internal heap after boot.
CONFIG_CAMERA_PSRAM_DMA=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# Care sync API base (local server, NOT api.tenclass.net)
CONFIG_CARE_API_BASE="http://192.168.0.33:8091"

# OTA endpoint on local server (returns websocket config, not mqtt)
CONFIG_OTA_URL="http://192.168.0.33:8091/api/device/ota/"

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y
# Builtin TLSF pool in PSRAM (lvgl_psram_pool.h). Keep the base pool small
# enough for 2MB PSRAM boards; 8MB boards add extra pools in lcd_display.cc
# (chunked to LV_MEM_SIZE — TLSF rejects a single add_pool larger than this).
# Variants that set CONFIG_SPIRAM=n are switched back to CLIB malloc in
# scripts/build.py; do not repeat that override on each board.
CONFIG_LV_USE_BUILTIN_MALLOC=y
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_MEM_SIZE_KILOBYTES=1024
